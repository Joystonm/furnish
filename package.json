{
  "name": "furnish-verified",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Furnish Verified — a floor-plan generator whose output is checked by an independent browser agent, with the whole verification history kept on screen.",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5199 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
